<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>EdgeAudioVisualizer</AssemblyName>
    <RootNamespace>ScreenAudioVisualizer</RootNamespace>
    <Product>Edge Audio Visualizer</Product>
    <AssemblyTitle>Edge Audio Visualizer</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\dist\**" CopyToOutputDirectory="PreserveNewest" Link="dist\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
